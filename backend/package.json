{
  "name": "whatsapp-guest-support-backend",
  "version": "1.0.0",
  "description": "AI-powered WhatsApp guest support backend for apartment booking & maintenance company",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate.js",
    "lint": "eslint src test scripts *.js",
    "seed:test": "node scripts/seedTestData.js",
    "test": "node --test",
    "test:unit": "node --test",
    "test:integration": "node scripts/runDatabaseIntegrationTests.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/db/client.js --test-coverage-lines=70 --test-coverage-branches=75 --test-coverage-functions=60",
    "check": "npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "axios": "^1.7.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "lucide-react": "^1.18.0",
    "morgan": "^1.10.0",
    "openai": "^4.52.7",
    "pg": "^8.22.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.6.0",
    "globals": "^14.0.0",
    "nodemon": "^3.1.4"
  }
}
