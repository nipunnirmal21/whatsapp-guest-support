# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Never commit .env — it contains secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres URI (required for `npm run migrate`)
# Supabase → Project Settings → Database → Connection string → URI
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_APP_SECRET=your-meta-app-secret
WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# ---------------------------------------------------------------------------
# Dashboard API auth (required for all /api/* routes)
# ---------------------------------------------------------------------------
DASHBOARD_API_KEY=your-long-random-dashboard-api-key

# ---------------------------------------------------------------------------
# OpenAI / LLM (used by classifyAndDraft — env name in code is LLM_API_KEY)
# ---------------------------------------------------------------------------
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o
# Alias kept for documentation clarity; the app reads LLM_API_KEY above.
OPENAI_API_KEY=sk-your-openai-api-key

# ---------------------------------------------------------------------------
# AI automation emergency control
# ---------------------------------------------------------------------------
# Dashboard automation settings are stored in the database. This server-side
# switch always wins and immediately disables AI auto-send after a restart.
AI_AUTO_REPLY_EMERGENCY_DISABLE=false

# ---------------------------------------------------------------------------
# Test Data Seeding
# ---------------------------------------------------------------------------
ALLOW_TEST_SEED=false
TEST_GUEST_PHONE=
