# =============================================================================
# WhatsApp Guest Support – Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# =============================================================================

# --- Meta / WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_whatsapp_business_account_id_here
WEBHOOK_VERIFY_TOKEN=a_random_secret_string_you_choose
META_APP_SECRET=your_meta_app_secret_here

# --- Supabase / Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# --- AI Provider (OpenAI or compatible) ---
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# --- Application ---
PORT=3000
NODE_ENV=development
BASE_URL=https://yourdomain.com

# --- Dashboard Access ---
INTERNAL_ADMIN_EMAILS=admin@yourcompany.com,ops@yourcompany.com

# --- Logging ---
LOG_LEVEL=info
