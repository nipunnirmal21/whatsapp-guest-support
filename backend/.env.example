# Copy this file to .env and replace every placeholder required by your setup.
# Never commit .env files or real secrets.

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase / PostgreSQL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_APP_SECRET=your-meta-app-secret
WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# OpenAI / LLM. The application reads LLM_API_KEY, not OPENAI_API_KEY.
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o

# Server-side emergency switch. Restart the backend after changing it.
AI_AUTO_REPLY_EMERGENCY_DISABLE=false

# Test-data seeding
ALLOW_TEST_SEED=false
TEST_GUEST_PHONE=
